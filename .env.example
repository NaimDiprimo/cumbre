# Cumbre — variables de entorno
# Copia este archivo a .env y ajusta los valores.

# Ambiente: dev | staging | prod
ENVIRONMENT=dev

# Secreto JWT del auth sidecar. CAMBIAR en producción.
CUMBRE_JWT_SECRET=dev-only-secret-change-me

# Credenciales BD (sólo aplica si cambias docker-compose.yml)
POSTGRES_USER=cumbre
POSTGRES_PASSWORD=cumbre
POSTGRES_DB=cumbre

# Grafana
GRAFANA_ADMIN_PASSWORD=cumbre
