# ═══════════════════════════════════════════════════════════
# Cumbre — Variables de entorno
# Copiá este archivo como .env y completá los valores
# NUNCA commitees el archivo .env a git
# ═══════════════════════════════════════════════════════════

# ── Base de datos ────────────────────────────────────────
POSTGRES_USER=cumbre
POSTGRES_DB=cumbre
# CAMBIAR en producción — mínimo 20 caracteres aleatorios
POSTGRES_DB_PASSWORD=cumbre-dev-change-in-prod

# ── JWT Auth ─────────────────────────────────────────────
# CAMBIAR en producción — mínimo 32 caracteres aleatorios
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
CUMBRE_JWT_SECRET=dev-only-secret-change-me-min-32-chars!!

# ── Grafana ──────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=cumbre-grafana-dev

# ── Entorno ──────────────────────────────────────────────
ENVIRONMENT=dev
