# ═══════════════════════════════════════════════════════════
# Cumbre — Variables de entorno
# Copiá este archivo como .env y completá los valores
# NUNCA commitees el archivo .env a git
# ═══════════════════════════════════════════════════════════

# ── Base de datos ────────────────────────────────────────
POSTGRES_USER=cumbre
POSTGRES_DB=cumbre
# CAMBIAR en producción — mínimo 20 caracteres aleatorios
POSTGRES_DB_PASSWORD=cumbre-dev-change-in-prod

# ── JWT Auth ─────────────────────────────────────────────
# CAMBIAR en producción — mínimo 32 caracteres aleatorios
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
CUMBRE_JWT_SECRET=dev-only-secret-change-me-min-32-chars!!

# ── Grafana ──────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=cumbre-grafana-dev

# ── Cumbre AI ────────────────────────────────────────────
# Obtener en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Google OAuth ─────────────────────────────────────────
# 1. Ir a https://console.cloud.google.com/apis/credentials
# 2. Crear "OAuth 2.0 Client ID" (tipo: Web application)
# 3. Agregar Authorized redirect URI: http://localhost:8000/auth/google/callback
# 4. Copiar Client ID y Client Secret acá
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Entorno ──────────────────────────────────────────────
ENVIRONMENT=dev
