{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(make:*)",
      "Bash(docker-compose ps:*)",
      "Bash(docker-compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sS http://localhost:*)",
      "Bash(.venv-test/bin/python -m pytest:*)",
      "Bash(../.venv-test/bin/python -m pytest:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Read(./**/.env)",
      "Edit(./**/.env)",
      "Write(./**/.env)"
    ]
  }
}
